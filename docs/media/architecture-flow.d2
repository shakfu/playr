# How an action runs in the terminal, and how results come back.
# Render: make diagrams

direction: right

terminal: "playr (terminal)" {
  input: "key event\n(crossterm)"
  key_of: "ui::key_of"
  prompt: ": prompt"
  app: "ui::App"
  render: "render::draw"
}

app: "playr-app" {
  keymap: "Keymap::lookup"
  parse: "command::parse"
  dispatch
  model: "Model\n(Frontend)"
  channel: "event channel"
}

core: "playr-core" {
  session: "Session"
  jobs: "jobs\npeaks, plan, write"
  engine: "audio engine"
  sink: "EventSink"
}

terminal.input -> terminal.key_of
terminal.key_of -> app.keymap: "Key"
terminal.prompt -> app.parse: "Model::run_command"
app.keymap -> app.dispatch: "Action"
app.parse -> app.dispatch: "Action"
app.dispatch -> core.session: "operations with explicit arguments"
core.session -> app.dispatch: "Notice"
app.dispatch -> app.model: "notify, prompt, confirm,\npresent, set_cursor"
core.session -> core.jobs: "starts"
core.jobs -> core.sink: "Peaks, Planned, Exported"
core.engine -> core.sink: "TrackChanged, StateChanged,\nPlaybackError"
core.sink -> app.channel: "Event"
app.channel -> app.model: "drained by refresh"
terminal.app -> app.model: "refresh, perform, answer"
terminal.app -> terminal.render: "&Screen"
terminal.render -> terminal.app: "Drawn"
